# Передайте настройки через переменные окружения или конфигурацию запуска IDE.
# Java не читает .env автоматически.

# PostgreSQL
DB_JDBC_URL=jdbc:postgresql://localhost:5432/business_insights
DB_USER=business_insights
DB_PASSWORD=

# Демодоступ: токен Bearer и ID физлица из загруженных данных.
BACKEND_DEMO_TOKEN=
BACKEND_DEMO_PERSON_ID=F_1

# ML-сервис
ML_BASE_URL=http://localhost:8000
ML_REQUEST_TIMEOUT=180s
# Срок актуальности новостей в ленте, от публикации или приёма недатированного события
FEED_MAX_AGE=30d
