# ./stack init creates local random values. Never commit .env.
POSTGRES_PASSWORD=
BACKEND_DEMO_TOKEN=
BACKEND_DEMO_PERSON_ID=F_1
FEED_MAX_AGE=30d
COMPOSE_PROJECT_NAME=business-insights
WEB_PORT=8088
# Absolute path recommended. Must contain the three importer CSV files.
DATA_DIR=./data-import/source-data

# Empty key does NOT enable mocks. Configure for actual model generation.
LLM_BASE_URL=https://changellenge.up.railway.app/v1
LLM_API_KEY=
LLM_MODEL_LIGHT=google/gemma-4-26b-a4b-it
LLM_MODEL_REASONING=google/gemma-4-26b-a4b-it
LLM_MODEL_FALLBACK=google/gemma-4-26b-a4b-it
LLM_TIMEOUT_SECONDS=60
LLM_DAILY_TOKEN_BUDGET=2000000
AGENT_MAX_SECONDS=120
AGENT_MAX_TOKENS_PER_RUN=40000
ML_REQUEST_TIMEOUT=180s

# Optional ./stack materials-up and ./stack materials <CLI arguments>
MATERIALS_STORE=./materials
PDF_DIR=./materials-input/pdf
MATERIALS_REVIEW_DIR=./materials-review
# Empty = http://127.0.0.1:WEB_PORT; Java requires absolute source URLs.
MATERIALS_PUBLIC_BASE_URL=
