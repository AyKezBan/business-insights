            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount Rub"
        },
        "share_of_flow": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Share Of Flow"
        },
        "okved_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Okved Code"
        },
        "okved_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Okved Name"
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "same_group": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Same Group"
        }
      },
      "required": [
        "company_id",
        "direction"
      ],
      "title": "Counterparty",
      "type": "object"
    },
    "NewsEvent": {
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "related_sources": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Related Sources",
          "type": "array"
        },
        "topics": {
          "items": {
            "type": "string"
          },
          "title": "Topics",
          "type": "array"
        }
      },
      "required": [
        "event_id",
        "title",
        "text",
        "source"
      ],
      "title": "NewsEvent",
      "type": "object"
    },
    "Products": {
      "properties": {
        "settlement": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
