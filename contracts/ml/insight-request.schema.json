        },
        "leasing": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Leasing"
        },
        "deposits": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deposits"
        },
        "payroll": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payroll"
        },
        "factoring": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Factoring"
        }
      },
      "title": "Products",
      "type": "object"
    },
    "SourceKind": {
      "enum": [
        "news",
        "bank",
        "profile"
      ],
      "title": "SourceKind",
      "type": "string"
    },
    "SourceRef": {
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "source_id",
        "kind",
        "title"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "UserRole": {
      "enum": [
        "owner",
        "ceo",
        "cfo",
        "chief_accountant",
        "treasurer",
        "other_c_level",
        "other"
      ],
      "title": "UserRole",
      "type": "string"
    }
  },
  "properties": {
    "profile": {
      "$ref": "#/$defs/CompanyProfile"
    },
    "role": {
      "$ref": "#/$defs/UserRole",
      "default": "ceo"
    },
    "event": {
      "$ref": "#/$defs/NewsEvent"
    }
  },
  "required": [
    "profile",
    "event"
  ],
  "title": "InsightRequest",
  "type": "object"
}
