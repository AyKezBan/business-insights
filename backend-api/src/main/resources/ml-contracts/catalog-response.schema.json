{
  "$defs": {
    "CatalogToken": {
      "additionalProperties": false,
      "properties": {
        "store_id": {
          "minLength": 1,
          "title": "Store Id",
          "type": "string"
        },
        "generation": {
          "minimum": 0,
          "title": "Generation",
          "type": "integer"
        },
        "revision": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "store_id",
        "generation",
        "revision"
      ],
      "title": "CatalogToken",
      "type": "object"
    },
    "MaterialEvent": {
      "properties": {
        "event": {
          "$ref": "#/$defs/NewsEvent"
        },
        "event_content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Event Content Sha256",
          "type": "string"
        }
      },
      "required": [
        "event",
        "event_content_sha256"
      ],
      "title": "MaterialEvent",
      "type": "object"
    },
    "NewsEvent": {
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "published_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published Date"
        },
        "published_precision": {
          "anyOf": [
            {
              "enum": [
                "timestamp",
                "date",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published Precision"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "related_sources": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Related Sources",
          "type": "array"
        },
        "topics": {
          "items": {
            "type": "string"
          },
          "title": "Topics",
          "type": "array"
        },
        "conflicts": {
          "items": {
            "$ref": "#/$defs/SourceConflict"
          },
          "title": "Conflicts",
          "type": "array"
        }
      },
      "required": [
        "event_id",
        "title",
        "text",
        "source"
      ],
      "title": "NewsEvent",
      "type": "object"
    },
    "SourceConflict": {
      "properties": {
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "resolved": {
          "default": false,
          "title": "Resolved",
          "type": "boolean"
        }
      },
      "required": [
        "reason",
        "source_ids"
      ],
      "title": "SourceConflict",
      "type": "object"
    },
    "SourceKind": {
      "enum": [
        "news",
        "bank",
        "profile"
      ],
      "title": "SourceKind",
      "type": "string"
    },
    "SourceRef": {
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "doc_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doc Id"
        },
        "content_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Sha256"
        },
        "excerpt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excerpt"
        },
        "publisher_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publisher Id"
        },
        "adapter_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter Id"
        },
        "material_type": {
          "anyOf": [
            {
              "enum": [
                "news_article",
                "public_analysis",
                "publisher_annotation",
                "indicator"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Material Type"
        },
        "completeness": {
          "anyOf": [
            {
              "enum": [
                "full",
                "partial"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completeness"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "published_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published Date"
        },
        "published_precision": {
          "anyOf": [
            {
              "enum": [
                "timestamp",
                "date",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published Precision"
        },
        "raw_publication": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Publication"
        },
        "source_timezone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Timezone"
        },
        "source_utc_offset_seconds": {
          "anyOf": [
            {
              "exclusiveMaximum": 86400,
              "exclusiveMinimum": -86400,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Utc Offset Seconds"
        },
        "timezone_provenance": {
          "anyOf": [
            {
              "enum": [
                "explicit_offset",
                "source_policy",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timezone Provenance"
        },
        "first_seen_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Seen At"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        },
        "statement_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Statement Type"
        },
        "target_period": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Period"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        },
        "rights_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rights Url"
        },
        "translation_attribution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Translation Attribution"
        }
      },
      "required": [
        "source_id",
        "kind",
        "title"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "properties": {
    "catalog_token": {
      "$ref": "#/$defs/CatalogToken"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/MaterialEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Cursor"
    }
  },
  "required": [
    "catalog_token",
    "events"
  ],
  "title": "CatalogResponse",
  "type": "object"
}
