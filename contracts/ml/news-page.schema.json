{
  "$defs": {
    "NewsEvent": {
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "related_sources": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Related Sources",
          "type": "array"
        },
        "topics": {
          "items": {
            "type": "string"
          },
          "title": "Topics",
          "type": "array"
        },
        "conflicts": {
          "items": {
            "$ref": "#/$defs/SourceConflict"
          },
          "title": "Conflicts",
          "type": "array"
        }
      },
      "required": [
        "event_id",
        "title",
        "text",
        "source"
      ],
      "title": "NewsEvent",
      "type": "object"
    },
    "SourceConflict": {
      "properties": {
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "resolved": {
          "default": false,
          "title": "Resolved",
          "type": "boolean"
        }
      },
      "required": [
        "reason",
        "source_ids"
      ],
      "title": "SourceConflict",
      "type": "object"
    },
    "SourceKind": {
      "enum": [
        "news",
        "bank",
        "profile"
      ],
      "title": "SourceKind",
      "type": "string"
    },
    "SourceRef": {
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "doc_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doc Id"
        },
        "content_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Sha256"
        },
        "excerpt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excerpt"
        }
      },
      "required": [
        "source_id",
        "kind",
        "title"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "properties": {
    "corpus_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Corpus Revision"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/NewsEvent"
      },
      "title": "Items",
      "type": "array"
    },
    "next_offset": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Offset"
    }
  },
  "required": [
    "items"
  ],
  "title": "NewsPage",
  "type": "object"
}
