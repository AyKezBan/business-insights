{
  "$defs": {
    "BankFragment": {
      "properties": {
        "fragment_id": {
          "title": "Fragment Id",
          "type": "string"
        },
        "doc_id": {
          "title": "Doc Id",
          "type": "string"
        },
        "doc_title": {
          "title": "Doc Title",
          "type": "string"
        },
        "doc_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doc Date"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "topics": {
          "items": {
            "type": "string"
          },
          "title": "Topics",
          "type": "array"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "content_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Sha256"
        },
        "char_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char Start"
        },
        "char_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char End"
        },
        "extraction_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extraction Method"
        },
        "review_status": {
          "default": "pending",
          "enum": [
            "pending",
            "verified",
            "rejected"
          ],
          "title": "Review Status",
          "type": "string"
        },
        "statement_type": {
          "default": "mixed",
          "enum": [
            "reported_fact",
            "bank_assessment",
            "forecast",
            "mixed"
          ],
          "title": "Statement Type",
          "type": "string"
        },
        "target_period": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Period"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        },
        "supersedes": {
          "items": {
            "type": "string"
          },
          "title": "Supersedes",
          "type": "array"
        }
      },
      "required": [
        "fragment_id",
        "doc_id",
        "doc_title",
        "text"
      ],
      "title": "BankFragment",
      "type": "object"
    },
    "DocumentMetadata": {
      "properties": {
        "doc_id": {
          "title": "Doc Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "doc_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doc Date"
        },
        "reported_period": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reported Period"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "page_count": {
          "minimum": 1,
          "title": "Page Count",
          "type": "integer"
        },
        "relative_path": {
          "title": "Relative Path",
          "type": "string"
        },
        "language": {
          "default": "rus+eng",
          "title": "Language",
          "type": "string"
        },
        "topics": {
          "items": {
            "type": "string"
          },
          "title": "Topics",
          "type": "array"
        }
      },
      "required": [
        "doc_id",
        "title",
        "sha256",
        "page_count",
        "relative_path"
      ],
      "title": "DocumentMetadata",
      "type": "object"
    },
    "ImportReport": {
      "properties": {
        "documents": {
          "default": 0,
          "title": "Documents",
          "type": "integer"
        },
        "pages": {
          "default": 0,
          "title": "Pages",
          "type": "integer"
        },
        "fragments": {
          "default": 0,
          "title": "Fragments",
          "type": "integer"
        },
        "news": {
          "default": 0,
          "title": "News",
          "type": "integer"
        },
        "errors": {
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        },
        "rejected": {
          "items": {
            "type": "string"
          },
          "title": "Rejected",
          "type": "array"
        }
      },
      "title": "ImportReport",
      "type": "object"
    },
    "NewsEvent": {
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        },
        "related_sources": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Related Sources",
          "type": "array"
        },
        "topics": {
          "items": {
            "type": "string"
          },
          "title": "Topics",
          "type": "array"
        },
        "conflicts": {
          "items": {
            "$ref": "#/$defs/SourceConflict"
          },
          "title": "Conflicts",
          "type": "array"
        }
      },
      "required": [
        "event_id",
        "title",
        "text",
        "source"
      ],
      "title": "NewsEvent",
      "type": "object"
    },
    "PageArtifact": {
      "properties": {
        "doc_id": {
          "title": "Doc Id",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "extraction_revision": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Extraction Revision",
          "type": "string"
        },
        "relative_text_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relative Text Path"
        },
        "text_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Sha256"
        },
        "method": {
          "enum": [
            "text",
            "tesseract"
          ],
          "title": "Method",
          "type": "string"
        },
        "status": {
          "enum": [
            "ready",
            "empty",
            "needs_review",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "errors": {
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        }
      },
      "required": [
        "doc_id",
        "page",
        "extraction_revision",
        "method",
        "status"
      ],
      "title": "PageArtifact",
      "type": "object"
    },
    "SourceConflict": {
      "properties": {
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "resolved": {
          "default": false,
          "title": "Resolved",
          "type": "boolean"
        }
      },
      "required": [
        "reason",
        "source_ids"
      ],
      "title": "SourceConflict",
      "type": "object"
    },
    "SourceKind": {
      "enum": [
        "news",
        "bank",
        "profile"
      ],
      "title": "SourceKind",
      "type": "string"
    },
    "SourceRef": {
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "doc_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doc Id"
        },
        "content_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Sha256"
        },
        "excerpt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excerpt"
        }
      },
      "required": [
        "source_id",
        "kind",
        "title"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "SourceVersion": {
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "first_seen_at": {
          "format": "date-time",
          "title": "First Seen At",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "event_id",
        "url",
        "revision",
        "content_sha256",
        "first_seen_at",
        "retrieved_at",
        "text"
      ],
      "title": "SourceVersion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "pipeline_version": {
      "default": "materials-v1",
      "title": "Pipeline Version",
      "type": "string"
    },
    "tool_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Tool Versions",
      "type": "object"
    },
    "revision": {
      "default": "",
      "title": "Revision",
      "type": "string"
    },
    "documents": {
      "items": {
        "$ref": "#/$defs/DocumentMetadata"
      },
      "title": "Documents",
      "type": "array"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/PageArtifact"
      },
      "title": "Pages",
      "type": "array"
    },
    "bank_fragments": {
      "items": {
        "$ref": "#/$defs/BankFragment"
      },
      "title": "Bank Fragments",
      "type": "array"
    },
    "news": {
      "items": {
        "$ref": "#/$defs/NewsEvent"
      },
      "title": "News",
      "type": "array"
    },
    "source_versions": {
      "items": {
        "$ref": "#/$defs/SourceVersion"
      },
      "title": "Source Versions",
      "type": "array"
    },
    "report": {
      "$ref": "#/$defs/ImportReport"
    }
  },
  "title": "CorpusSnapshot",
  "type": "object"
}
