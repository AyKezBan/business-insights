{
  "properties": {
    "fragment_id": {
      "title": "Fragment Id",
      "type": "string"
    },
    "doc_id": {
      "title": "Doc Id",
      "type": "string"
    },
    "doc_title": {
      "title": "Doc Title",
      "type": "string"
    },
    "doc_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Doc Date"
    },
    "page": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Page"
    },
    "text": {
      "title": "Text",
      "type": "string"
    },
    "topics": {
      "items": {
        "type": "string"
      },
      "title": "Topics",
      "type": "array"
    },
    "source_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Url"
    },
    "content_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content Sha256"
    },
    "char_start": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Char Start"
    },
    "char_end": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Char End"
    },
    "extraction_method": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Extraction Method"
    },
    "review_status": {
      "default": "pending",
      "enum": [
        "pending",
        "verified",
        "rejected"
      ],
      "title": "Review Status",
      "type": "string"
    },
    "statement_type": {
      "default": "mixed",
      "enum": [
        "reported_fact",
        "bank_assessment",
        "forecast",
        "mixed"
      ],
      "title": "Statement Type",
      "type": "string"
    },
    "target_period": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Period"
    },
    "valid_until": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid Until"
    },
    "supersedes": {
      "items": {
        "type": "string"
      },
      "title": "Supersedes",
      "type": "array"
    }
  },
  "required": [
    "fragment_id",
    "doc_id",
    "doc_title",
    "text"
  ],
  "title": "BankFragment",
  "type": "object"
}
