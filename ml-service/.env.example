LLM_BASE_URL=https://changellenge.up.railway.app/v1
LLM_API_KEY=

# Разрешённая Gemma проверена live; роли могут использовать одну модель.
# Qwen/GLM требуют отдельной проверки timeout/reasoning бюджета.
LLM_MODEL_LIGHT=google/gemma-4-26b-a4b-it
LLM_MODEL_REASONING=google/gemma-4-26b-a4b-it
LLM_MODEL_FALLBACK=google/gemma-4-26b-a4b-it

AGENT_MAX_ITERATIONS=3
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_TOKENS_PER_RUN=200000
LLM_TIMEOUT_SECONDS=120

# лимит на день на весь сервис
LLM_DAILY_TOKEN_BUDGET=2000000

# Бюджет в рублях на общий ключ команды (лимит кейса 500 руб./день); состояние в TRACE_DIR/budget_state.json.
# Сервис видит только свои вызовы, расход остальных участников на тот же ключ ему неизвестен.
LLM_DAILY_BUDGET_RUB=500
LLM_BUDGET_WARN_RUB=350
LLM_BUDGET_STOP_OPTIONAL_RUB=450
# Тарифы провайдера НЕ подтверждены: цены по умолчанию завышены намеренно. Подставить реальные:
# LLM_PRICES_JSON={"gemma-4-26b-a4b": {"in": "0.05", "out": "0.15"}}
LLM_PRICE_DEFAULT_IN_RUB_PER_1K=0.5
LLM_PRICE_DEFAULT_OUT_RUB_PER_1K=1.5
BUDGET_TIMEZONE=Europe/Moscow
AGENT_MAX_SECONDS=480

# Открытые официальные источники (ключевая ставка, курсы, пресс-релизы cbr.ru). Запросы только по https к cbr.ru.
OPEN_RESEARCH_ENABLED=true
# OPEN_RESEARCH_CACHE_DIR=traces/open_cache

BANK_FRAGMENTS_PATH=data/bank_fragments.jsonl
NEWS_PATH=data/news.jsonl
TRACE_DIR=traces
# Optional versioned corpus. When enabled, missing/corrupt snapshots fail startup.
# MATERIALS_DIR=/app/materials
MATERIALS_PUBLIC_BASE_URL=
