          "title": "Source Ids",
          "type": "array"
        },
        "profile_features": {
          "items": {
            "type": "string"
          },
          "title": "Profile Features",
          "type": "array"
        }
      },
      "required": [
        "text",
        "kind"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ClaimKind": {
      "enum": [
        "fact",
        "assessment",
        "inference",
        "hypothesis",
        "recommendation",
        "unavailable"
      ],
