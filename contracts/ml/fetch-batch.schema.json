{
  "$defs": {
    "RawNews": {
      "properties": {
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "published_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published Date"
        },
        "published_precision": {
          "default": "unknown",
          "enum": [
            "timestamp",
            "date",
            "unknown"
          ],
          "title": "Published Precision",
          "type": "string"
        },
        "raw_publication": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Publication"
        },
        "source_timezone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Timezone"
        },
        "source_utc_offset_seconds": {
          "anyOf": [
            {
              "exclusiveMaximum": 86400,
              "exclusiveMinimum": -86400,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Utc Offset Seconds"
        },
        "timezone_provenance": {
          "default": "unknown",
          "enum": [
            "explicit_offset",
            "source_policy",
            "unknown"
          ],
          "title": "Timezone Provenance",
          "type": "string"
        },
        "publisher_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publisher Id"
        },
        "adapter_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter Id"
        },
        "discovered_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Discovered Url"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "material_type": {
          "default": "news_article",
          "enum": [
            "news_article",
            "public_analysis",
            "publisher_annotation",
            "indicator"
          ],
          "title": "Material Type",
          "type": "string"
        },
        "completeness": {
          "default": "full",
          "enum": [
            "full",
            "partial"
          ],
          "title": "Completeness",
          "type": "string"
        },
        "parser_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parser Version"
        },
        "rights_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rights Url"
        },
        "translation_attribution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Translation Attribution"
        },
        "topics": {
          "items": {
            "type": "string"
          },
          "title": "Topics",
          "type": "array"
        },
        "original_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Text"
        },
        "raw_body": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Body"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        }
      },
      "required": [
        "url",
        "title",
        "text",
        "retrieved_at"
      ],
      "title": "RawNews",
      "type": "object"
    }
  },
  "properties": {
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/RawNews"
      },
      "title": "Records",
      "type": "array"
    },
    "status": {
      "enum": [
        "ok",
        "partial",
        "empty",
        "unchanged",
        "blocked",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "attempted": {
      "default": 0,
      "minimum": 0,
      "title": "Attempted",
      "type": "integer"
    },
    "succeeded": {
      "default": 0,
      "minimum": 0,
      "title": "Succeeded",
      "type": "integer"
    },
    "rejected": {
      "default": 0,
      "minimum": 0,
      "title": "Rejected",
      "type": "integer"
    },
    "item_errors": {
      "items": {
        "type": "string"
      },
      "title": "Item Errors",
      "type": "array"
    },
    "checked_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Checked At"
    },
    "last_success_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Success At"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "etag": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Etag"
    },
    "last_modified": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Modified"
    }
  },
  "required": [
    "source_id",
    "status"
  ],
  "title": "FetchBatch",
  "type": "object"
}
