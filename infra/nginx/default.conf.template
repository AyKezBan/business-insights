# Only this local gateway is published. The token never enters a browser bundle.
map "$http_origin|$http_host" $origin_ok {
    default 0;
    ~^\| 1;
    ~^http://([^/]+)\|\1$ 1;
}
map $host $host_ok {
    default 0;
    localhost 1;
    127.0.0.1 1;
    frontend 1; # internal Compose checks only
}
server {
    listen 80;
    server_name _;
    if ($host_ok = 0) { return 403; }
    root /usr/share/nginx/html;
    resolver 127.0.0.11 valid=10s ipv6=off;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; frame-ancestors 'none'; base-uri 'none'" always;
    add_header Cache-Control no-store always;
    client_max_body_size 1m;

    location = /health { access_log off; return 200 'ok\n'; }
    location /api/v1/ {
        if ($origin_ok = 0) { return 403; }
        set $backend http://backend:8080;
        proxy_pass $backend$request_uri;
        proxy_set_header Authorization "Bearer ${BACKEND_DEMO_TOKEN}";
        proxy_set_header Host $host;
        proxy_connect_timeout 5s;
        proxy_read_timeout 200s;
    }
    location /v1/materials/documents/ {
        limit_except GET { deny all; }
        set $ml http://ml:8000;
        proxy_pass $ml$request_uri;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
    location /api/ { return 404; }
    location / { try_files $uri $uri/ =404; }
}
